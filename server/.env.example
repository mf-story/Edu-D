# Contoh variabel lingkungan server Edu-D. Salin ke `.env` atau set langsung
# saat menjalankan (mis. lewat pm2). JANGAN commit file .env asli.

# Port HTTP server (default 4000). Untuk produksi bisa 80 (atau di belakang nginx/Caddy).
PORT=4000

# Kunci rahasia penanda-tangan token sesi (WAJIB diisi teks acak panjang di produksi).
EDUD_SECRET=ganti-dengan-teks-acak-panjang

# Daftar origin yang diizinkan (dipisah koma), mis. domain produksi Anda.
# localhost & jaringan lokal (LAN) sudah otomatis diizinkan.
EDUD_ORIGINS=https://edu.contoh.com
